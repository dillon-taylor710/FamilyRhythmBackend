<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Purchases — Family Rhythm Admin</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <%- include('partials/styles') %>
</head>
<body>
  <%- include('partials/nav', { active: 'purchases' }) %>
  <main>
    <h1>Purchases</h1>

    <div class="totals-strip">
      <div><strong><%= result.total %></strong><span>Total matching purchases</span></div>
      <div><strong>$<%= result.totalAmount.toFixed(2) %></strong><span>Total amount (valid only)</span></div>
    </div>

    <form class="filter-bar" method="get" action="/admin/purchases">
      <div class="filter-row">
        <div class="filter-field">
          <label>Email</label>
          <input type="text" name="email" value="<%= query.email || '' %>" placeholder="Search by email" />
        </div>
        <div class="filter-field">
          <label>Plan</label>
          <input type="text" name="plan" value="<%= query.plan || '' %>" placeholder="Search by plan" />
        </div>
        <div class="filter-field">
          <label>Platform</label>
          <select name="platform">
            <option value="" <%= !query.platform ? 'selected' : '' %>>Any</option>
            <option value="android" <%= query.platform === 'android' ? 'selected' : '' %>>android</option>
            <option value="ios" <%= query.platform === 'ios' ? 'selected' : '' %>>ios</option>
          </select>
        </div>
        <div class="filter-field">
          <label>From (purchase date)</label>
          <input type="date" name="from" value="<%= range.from %>" />
        </div>
        <div class="filter-field">
          <label>To (purchase date)</label>
          <input type="date" name="to" value="<%= range.to %>" />
        </div>
        <div class="filter-actions">
          <button type="submit" class="btn primary">Search</button>
          <a class="btn" href="/admin/purchases">Reset</a>
        </div>
      </div>
      <%- include('partials/dateRangeFilter') %>
    </form>

    <% if (result.items.length === 0) { %>
      <div class="empty">No purchases match this search.</div>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>User</th>
            <th>Plan</th>
            <th>Platform</th>
            <th>Purchase date</th>
            <th>Result</th>
            <th>Amount</th>
          </tr>
        </thead>
        <tbody>
          <% result.items.forEach(function(t) { %>
            <tr>
              <td><%= t.email %> <span style="color:#838a94">(<%= t.displayName %>)</span></td>
              <td><%= t.productId %></td>
              <td><%= t.platform %></td>
              <td><%= new Date(t.verifiedAt).toLocaleString() %></td>
              <td><span class="badge <%= t.verificationResult %>"><%= t.verificationResult %></span></td>
              <td><%= t.amount ? '$' + t.amount.toFixed(2) : '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <%- include('partials/pagination') %>
    <% } %>
  </main>
</body>
</html>
