<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Subscriptions — Family Rhythm Admin</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <%- include('partials/styles') %>
</head>
<body>
  <%- include('partials/nav', { active: 'subscriptions' }) %>
  <main>
    <h1>Subscriptions</h1>

    <div class="totals-strip">
      <div><strong><%= result.total %></strong><span>Total matching subscriptions</span></div>
    </div>

    <form class="filter-bar" method="get" action="/admin/subscriptions">
      <div class="filter-row">
        <div class="filter-field">
          <label>Email</label>
          <input type="text" name="email" value="<%= query.email || '' %>" placeholder="Search by email" />
        </div>
        <div class="filter-field">
          <label>Status</label>
          <select name="status">
            <option value="" <%= !query.status ? 'selected' : '' %>>Any</option>
            <option value="active_trial" <%= query.status === 'active_trial' ? 'selected' : '' %>>active_trial</option>
            <option value="active_paid" <%= query.status === 'active_paid' ? 'selected' : '' %>>active_paid</option>
            <option value="expired_trial" <%= query.status === 'expired_trial' ? 'selected' : '' %>>expired_trial</option>
            <option value="expired_subscription" <%= query.status === 'expired_subscription' ? 'selected' : '' %>>expired_subscription</option>
            <option value="cancelled" <%= query.status === 'cancelled' ? 'selected' : '' %>>cancelled</option>
          </select>
        </div>
        <div class="filter-field">
          <label>Plan</label>
          <input type="text" name="plan" value="<%= query.plan || '' %>" placeholder="Search by plan" />
        </div>
        <div class="filter-field">
          <label>Platform</label>
          <select name="platform">
            <option value="" <%= !query.platform ? 'selected' : '' %>>Any</option>
            <option value="android" <%= query.platform === 'android' ? 'selected' : '' %>>android</option>
            <option value="ios" <%= query.platform === 'ios' ? 'selected' : '' %>>ios</option>
          </select>
        </div>
        <div class="filter-field">
          <label>From (updated)</label>
          <input type="date" name="from" value="<%= range.from %>" />
        </div>
        <div class="filter-field">
          <label>To (updated)</label>
          <input type="date" name="to" value="<%= range.to %>" />
        </div>
        <div class="filter-actions">
          <button type="submit" class="btn primary">Search</button>
          <a class="btn" href="/admin/subscriptions">Reset</a>
        </div>
      </div>
      <%- include('partials/dateRangeFilter') %>
    </form>

    <% if (result.items.length === 0) { %>
      <div class="empty">No subscriptions match this search.</div>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>User</th>
            <th>Status</th>
            <th>Plan</th>
            <th>Platform</th>
            <th>Auto-renew</th>
            <th>Current period ends</th>
            <th>Transactions</th>
          </tr>
        </thead>
        <tbody>
          <% result.items.forEach(function(s) { %>
            <tr>
              <td><%= s.email %> <span style="color:#838a94">(<%= s.displayName %>)</span></td>
              <td><span class="badge <%= s.status %>"><%= s.status %></span></td>
              <td><%= s.planId || '—' %></td>
              <td><%= s.platform || '—' %></td>
              <td><%= s.autoRenewing ? 'Yes' : 'No' %></td>
              <td><%= s.currentPeriodEnd ? new Date(s.currentPeriodEnd).toLocaleString() : '—' %></td>
              <td><%= s.transactionCount %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <%- include('partials/pagination') %>
    <% } %>
  </main>
</body>
</html>
