# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL="postgresql://family_rhythm:changeme@localhost:5432/family_rhythm?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call the user-facing API.
CORS_ORIGINS=http://localhost:3001

# --- Auth (mobile app users) ---
# Long random string. e.g. `openssl rand -hex 32`
JWT_USER_SECRET=replace-with-a-long-random-secret
JWT_USER_EXPIRES_IN=30d

# --- Admin auth (separate secret/audience from user auth on purpose —
# an admin token must never be accepted by the user-facing API) ---
JWT_ADMIN_SECRET=replace-with-a-different-long-random-secret
JWT_ADMIN_EXPIRES_IN=10m
# Name of the httpOnly cookie the admin web pages use to carry the admin JWT.
ADMIN_COOKIE_NAME=family_rhythm_admin

# --- Google Play Developer API (Android purchase verification) ---
# Path to a service-account JSON key file with access to the Play Console
# app's "Financial data" / "View app information" permissions, OR the raw
# JSON contents (one or the other — GOOGLE_SERVICE_ACCOUNT_JSON wins if set).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.app.family_rhythm

# --- Password reset emails (POST /api/auth/forgot-password) ---
# Base URL used to build the link mailed out — must be reachable by
# whoever clicks it, so a real domain in production, not localhost.
APP_BASE_URL=http://localhost:4000
# All optional — leave unset in dev and the reset link is logged to the
# console instead of emailed (see src/utils/mailer.ts).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Family Rhythm <no-reply@familyrhythm.app>"

# --- Apple App Store Server API (iOS purchase verification) ---
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# PEM contents of the .p8 private key downloaded from App Store Connect.
# Keep the literal \n line breaks if stored as a single env var.
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.app.familyRhythm
# true while testing against Sandbox purchases, false in production.
APPLE_USE_SANDBOX=true
